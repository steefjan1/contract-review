{
  "openapi": "3.0.3",
  "info": {
    "title": "Claims API",
    "version": "2.0.0"
  },
  "paths": {
    "/claims/{id}": {
      "get": {
        "operationId": "getClaim",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A claim",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "status"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "open",
                        "approved",
                        "rejected",
                        "withdrawn"
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Claim not found"
          }
        }
      }
    }
  }
}