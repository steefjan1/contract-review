{
  "spec": "{\n  \"openapi\": \"3.0.3\",\n  \"info\": {\n    \"title\": \"Claims API\",\n    \"version\": \"1.1.0\"\n  },\n  \"paths\": {\n    \"/claims/{id}\": {\n      \"get\": {\n        \"operationId\": \"getClaim\",\n        \"parameters\": [\n          {\n            \"name\": \"id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"A claim\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"type\": \"object\",\n                  \"required\": [\n                    \"id\",\n                    \"status\",\n                    \"amount\"\n                  ],\n                  \"properties\": {\n                    \"id\": {\n                      \"type\": \"string\"\n                    },\n                    \"status\": {\n                      \"type\": \"string\",\n                      \"enum\": [\n                        \"open\",\n                        \"approved\",\n                        \"rejected\"\n                      ]\n                    },\n                    \"amount\": {\n                      \"type\": \"number\"\n                    },\n                    \"currency\": {\n                      \"type\": \"string\"\n                    }\n                  }\n                }\n              }\n            }\n          },\n          \"404\": {\n            \"description\": \"Claim not found\"\n          }\n        }\n      }\n    }\n  }\n}"
}